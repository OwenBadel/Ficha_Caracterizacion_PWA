# Variables de Entorno de Ejemplo — PROJ-006 Ficha Caracterización PWA
# Arquitectura Soberana: Visión Artificial Local en GPU NVIDIA RTX 4060 con Ollama
VISION_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl

# Patrón Maestro & Caché Forense de Participantes (Jaro-Winkler)
# ID de la hoja de Google Sheets (lo que está entre /d/ y /edit en la URL de tu hoja de cálculo)
GOOGLE_SHEET_ID=tu_google_sheet_id_aqui
GOOGLE_SHEET_TAB_PATRON_MAESTRO=PATRON MAESTRO

# Google Sheets (Sincronización Webhook Google Apps Script)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycb.../exec
GOOGLE_APPS_SCRIPT_URL_TESTS=https://script.google.com/macros/s/AKfycb.../exec
GOOGLE_SHEET_TAB=Respuestas
GOOGLE_SHEET_TAB_TESTS=Pre_Post_Test
GOOGLE_SHEET_SKIP_FIRST_COL=true

# Servidor Local / Red Móvil (PWA Mobile-First)
HOST=0.0.0.0
PORT=8000

# Fallback opcional (solo si se desea respaldo en la nube)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
