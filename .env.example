# Variables de Entorno de Ejemplo — PROJ-006 Ficha Caracterización PWA
VISION_PROVIDER=gemini
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MIN_INTERVAL_SECONDS=2.0

# Patrón Maestro & Caché Forense de Participantes (Jaro-Winkler)
GOOGLE_SHEET_ID=tu_google_sheet_id_aqui
GOOGLE_SHEET_TAB_PATRON_MAESTRO=PATRON MAESTRO

# Pestañas Exactas en Google Sheets
GOOGLE_SHEET_TAB=Respuestas de formulario 1
GOOGLE_SHEET_TAB_PRE_TEST=PRE-TEST
GOOGLE_SHEET_TAB_POST_TEST=POST-TEST

# Google Sheets Webhooks
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycb.../exec
GOOGLE_APPS_SCRIPT_URL_TESTS=https://script.google.com/macros/s/AKfycb.../exec
GOOGLE_SHEET_SKIP_FIRST_COL=true

# Módulo Anexo 17 (Pellízcate con Generación B+)
GOOGLE_SHEET_ID_ANEXO17=tu_google_sheet_id_anexo17_aqui
GOOGLE_APPS_SCRIPT_URL_ANEXO17=https://script.google.com/macros/s/AKfycb.../exec
GOOGLE_SHEET_TAB_ANEXO17_PRE=PRE-TEST
GOOGLE_SHEET_TAB_ANEXO17_POST=POST-TEST

# Servidor Local / Red Móvil
HOST=0.0.0.0
PORT=8000
