# =====================================================================
# 1. MOTOR DE VISIÓN OCR CON IA (GOOGLE GEMINI)
# =====================================================================
VISION_PROVIDER=gemini
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MIN_INTERVAL_SECONDS=2.0

# =====================================================================
# 2. GOOGLE SHEET PRINCIPAL: PATRÓN MAESTRO, ANEXO 10 Y ANEXO 4
# ID de la Hoja de Cálculo compartida para Fichas y Anexo 4
# =====================================================================
GOOGLE_SHEET_ID=tu_google_sheet_id_aqui
GOOGLE_SHEET_SKIP_FIRST_COL=true

# --- 2.1 PATRÓN MAESTRO (Reconciliación caligráfica Jaro-Winkler) ---
GOOGLE_SHEET_TAB_PATRON_MAESTRO=PATRON MAESTRO

# --- 2.2 MÓDULO 1: ANEXO 10 (Ficha de Caracterización — 2 Páginas) ---
# Pestaña destino y Webhook de Google Apps Script para Anexo 10
GOOGLE_SHEET_TAB=Respuestas de formulario 1
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycb.../exec

# --- 2.3 MÓDULO 2: ANEXO 4 (Pre/Post Test SSR ITS — Hoja Única) ---
# Pestañas de destino y Webhook de Google Apps Script para Anexo 4
GOOGLE_SHEET_TAB_PRE_TEST=PRE-TEST
GOOGLE_SHEET_TAB_POST_TEST=POST-TEST
GOOGLE_APPS_SCRIPT_URL_TESTS=https://script.google.com/macros/s/AKfycb.../exec

# =====================================================================
# 3. MÓDULO 3: ANEXO 17 — PELLÍZCATE CON GENERACIÓN B+
# Exclusivo El Carmen de Bolívar (2 Páginas por Test)
# Hoja de cálculo y Webhook de Google Apps Script independientes
# =====================================================================
GOOGLE_SHEET_ID_ANEXO17=tu_google_sheet_id_anexo17_aqui
GOOGLE_APPS_SCRIPT_URL_ANEXO17=https://script.google.com/macros/s/AKfycb.../exec
GOOGLE_SHEET_TAB_ANEXO17_PRE=PRE-TEST
GOOGLE_SHEET_TAB_ANEXO17_POST=POST-TEST

# =====================================================================
# 4. SERVIDOR LOCAL / ACCESO EN RED MÓVIL (PWA MOBILE-FIRST)
# =====================================================================
HOST=0.0.0.0
PORT=8000
