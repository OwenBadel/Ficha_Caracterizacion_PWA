# =====================================================================
# VARIABLES DE ENTORNO — PROJ-006 FICHA CARACTERIZACIÓN PWA
# =====================================================================

# 1. Proveedor de IA de Visión (openrouter, gemini u openai)
VISION_PROVIDER=openrouter

# Configuración si usas OpenRouter (Recomendado)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen2.5-vl-72b-instruct

# Configuración si usas Google Gemini (Fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Opcional si usas OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# 2. Configuración de Google Sheets (Método A: Service Account Oficial)
# ID que aparece en la URL: https://docs.google.com/spreadsheets/d/<ID_AQUI>/edit
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Respuestas
# Ruta a tu archivo de credenciales descargado de Google Cloud Console
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# 3. Configuración de Google Sheets (Método B: Webhook Google Apps Script alternativo)
# Si prefieres no usar credentials.json, pega aquí la URL de tu Web App de Apps Script:
GOOGLE_APPS_SCRIPT_URL=
# Deja vacía la primera columna si tu hoja inicia con 'Marca temporal'
GOOGLE_SHEET_SKIP_FIRST_COL=true

# 4. Configuración para Pre-Test y Post-Test (Anexo 4 SSR ITS)
# Pestaña en Google Sheets para los Tests (por defecto 'Respuestas de formulario 1')
GOOGLE_SHEET_TAB_TESTS=Respuestas de formulario 1
# Si usas un Webhook separado para la hoja de Tests, descomenta y configúralo:
# GOOGLE_APPS_SCRIPT_URL_TESTS=https://script.google.com/macros/s/.../exec

# 4. Configuración del Servidor
HOST=0.0.0.0
PORT=8000
